{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kijkdoos",
  "compatibility_date": "2026-09-04",
  "main": "./worker/think.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "BRAIN": "cf"
  }
}
